PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_ORIGIN=http://localhost:3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=worldwarden
# Same password as DB_PASSWORD in the .env file in the project root
DB_PASSWORD=worldpass
DB_NAME=worldwarden

# Externa API:er (fyll i i din egen .env)
FLAG_API_URL=
COUNTRY_API_URL=
QUIZ_API_URL=
# Om API:et kräver nyckel
API_KEY=

# GitHub OAuth2 (skapa en OAuth App på github.com/settings/developers)
# Authorization callback URL: BACKEND_ORIGIN + /api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
